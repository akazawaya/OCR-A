# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-development-only
DJANGO_ALLOWED_HOSTS="localhost"
DJANGO_CORS_ALLOWED_ORIGINS="http://localhost:5173"

# PostgreSQL
POSTGRES_DB=ocr_a
POSTGRES_USER=ocr_a
POSTGRES_PASSWORD=change-me-for-development-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/

# Docker Compose
# 開発用プロファイル:
#   development-shared
#   development-dedicated
COMPOSE_PROFILES=development-shared

# Redis
CHANNEL_REDIS_URL=redis://broker:6379/0
CELERY_BROKER_URL=redis://broker:6379/1
CELERY_RESULT_BACKEND=redis://broker:6379/2

# OCR timeout
DOCUMENT_OCR_TOTAL_TIMEOUT_MINUTES=60
DOCUMENT_OCR_PAGE_TIMEOUT_MINUTES=15

# Upload
MAX_UPLOAD_FILE_SIZE_MB=10
