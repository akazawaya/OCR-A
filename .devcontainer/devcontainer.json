{
  "name": "OCR-A",
  "dockerComposeFile": [
    "../compose.yaml",
    "docker-compose.yml"
  ],
  "service": "backend",
  "runServices": ["backend", "db", "broker", "worker"],
  "workspaceFolder": "/workspace/OCR-A",
  "remoteEnv": {
    "PATH": "/app/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "bradlc.vscode-tailwindcss",
        "caioyuri.json-to-pydantic",
        "christian-kohler.path-intellisense"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y nano && npm install -g lefthook"
}