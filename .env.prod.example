# 本番環境で使用する値の配置例です。
# .env.prodとしてEC2へ配置するファイルではありません。

# 1. GitHub Actions用の固定値
# 配置先: GitHub Environment "production"

# Variables
# EC2配置CD、Redis Lambda配置CD、Initialize（EC2、Redis Role State）の共通値
AWS_REGION=ap-northeast-1

# EC2配置CD用
EC2_TARGET_TAG_KEY=DeploymentTarget
VITE_API_BASE_URL=https://api.example.com/api/

# CPU EC2のCD時、Celery Beatをactiveだけに起動するためのRole State
# Lambdaの同名環境変数と同じ値にする。
REDIS_ROLE_STATE_PARAMETER_NAME=/ocr-a/redis/roles

# Redis Lambda配置CD用
REDIS_FAILOVER_LAMBDA_FUNCTION_NAME=ocr-a-redis-failover
REDIS_RECOVERY_LAMBDA_FUNCTION_NAME=ocr-a-redis-recovery

# Secret
# EC2配置CD、Redis Lambda配置CD、Initialize（EC2、Redis Role State）の兼用ARN
AWS_GITHUB_ACTIONS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/ocr-a-github-actions-role

# 2. CD実行ごとに選択する値
# 配置先: cd.yamlのworkflow_dispatch inputs

# 本番用Composeプロファイルを選択する。
# 開発用のCOMPOSE_PROFILESに相当する。
deployment_profile=production-cpu
# 選択肢:
#   production-cpu
#   production-gpu-shared
#   production-gpu-dedicated

# 対象EC2が読み込むParameter Storeのパスを指定する。
# CPU例: /ocr-a/cpu/
# GPU例: /ocr-a/gpu/
# production-gpu-sharedとproduction-gpu-dedicatedは同じGPU用パスを使用する。
parameter_store_path=/ocr-a/cpu/

# 3. Redis Lambda実行時の値
# 配置先: AWS Lambdaの環境変数

# Failover / Recovery共通
REDIS_ROLE_STATE_PARAMETER_NAME=/ocr-a/redis/roles
FENCED_SECURITY_GROUP_ID=sg-xxxxxxxxxxxxxxxxx
CPU_PARAMETER_STORE_PATH=/ocr-a/cpu/
DEPLOYMENT_PROFILE=production-cpu
VITE_API_BASE_URL=https://api.example.com/api/

# Failover Lambdaのみ
ROUTE53_HOSTED_ZONE_ID=ZXXXXXXXXXXXXXXXXXXXX
# CPU・GPUのParameter Storeに設定するREDIS_HOSTと同じ固定DNS名。
REDIS_HOST=redis.internal.example.com

# Recovery Lambdaのみ
RESTORE_SECURITY_GROUPS_PARAMETER_NAME=/ocr-a/redis/restore-security-groups

# 4. アプリケーション実行時の値
# 配置先: AWS Systems Manager Parameter Store
# CPU用とGPU用の各parameter_store_path直下に、必要な環境変数名でパラメータを作成する。
# 例: /ocr-a/cpu/DJANGO_DEBUG
# /cpu/には下記を全配置。/gpu/はGPU EC2制御値が不要のためそれ以外を配置する。
# DJANGO_SECRET_KEYとPOSTGRES_PASSWORDはSecureStringは「安全な文字列」で作成する。

# Django
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://example.com

# PostgreSQL（Amazon RDS）
POSTGRES_DB=ocr_a
POSTGRES_USER=ocr_a
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=ocr-a-db.example.ap-northeast-1.rds.amazonaws.com
POSTGRES_PORT=5432

# Redis
# CPU・GPUともFailover Lambdaと同じRoute 53の固定DNS名を指定する。
REDIS_HOST=redis.internal.example.com

# OCR timeout
DOCUMENT_OCR_TOTAL_TIMEOUT_MINUTES=60
DOCUMENT_OCR_PAGE_TIMEOUT_MINUTES=15

# Upload
# Nginxのclient_max_body_sizeがより上位の上限となるため、変更時は連動させる。
MAX_UPLOAD_FILE_SIZE_MB=10

# Amazon S3
AWS_STORAGE_BUCKET_NAME=ocr-a-s3-ACCOUNT_ID-ap-northeast-1-an
AWS_S3_REGION_NAME=ap-northeast-1

# GPU EC2制御値
AWS_EC2_REGION_NAME=ap-northeast-1
# GPU_WORKERSはdeployment_profileのshared, dedicatedに連動させる。
GPU_WORKERS=[{"instance_id":"i-xxxxxxxxxxxxxxxxx","queues":["ocr_document_queue","ocr_word_queue"]}]
GPU_WORKER_AUTOSTOP_IDLE_MINUTES=30
GPU_WORKER_AUTOSTOP_CHECK_INTERVAL_SECONDS=60
